# Server
PORT=5000
NODE_ENV=development

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (defaults are sensible for chat intent fallback)
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MAX_RETRIES=2
# GEMINI_RETRY_DELAY_MS=600

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyxxxxx

# JWT (required for wallet login — sign nonce → verify → Bearer token)
JWT_SECRET=your_secret_key_here_change_in_production

# Frontend
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# ── UGF On-Chain Execution ──────────────────────────────────────────────────────
# UGF_PAYMENT_WALLET=user (default) — connected wallet pays TYI Mock USD.
# UGF_PAYMENT_WALLET=server — server signer pays TYI (fund 0x9090… on faucet).
# UGF_SIGNER_PRIVATE_KEY = contract owner; submits mint tx (onlyOwner).
# NFT_CONTRACT_ADDRESS   = mint/donate call target.

# Global signer — fund THIS address with TYI Mock USD on the UGF dashboard.
# Deploy contract with initialOwner = address derived from this key.
# ⚠️  Never commit a real private key — use a dedicated testnet wallet only.
UGF_SIGNER_PRIVATE_KEY=0xyour_hex_private_key_here

# Deployed contract on Base Sepolia (call target for mintBadge / donate):
NFT_CONTRACT_ADDRESS=0xyour_contract_address_here

# Base Sepolia RPC (default is the public endpoint — override for reliability)
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Block explorer tx URL template ({txHash} replaced). Default: Base Sepolia (Basescan)
# EXPLORER_TX_URL_TEMPLATE=https://sepolia.basescan.org/tx/{txHash}
# CHAIN_DISPLAY_NAME=Base Sepolia
# UGF_POLL_TIMEOUT_MS=120000
# UGF_POLL_INTERVAL_MS=2000
