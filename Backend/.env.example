# Server
PORT=5000
NODE_ENV=development

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (defaults are sensible for chat intent fallback)
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MAX_RETRIES=2
# GEMINI_RETRY_DELAY_MS=600

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyxxxxx

# JWT (required for wallet login — sign nonce → verify → Bearer token)
JWT_SECRET=your_secret_key_here_change_in_production

# Frontend
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# ── UGF On-Chain Execution ──────────────────────────────────────────────────────
# Required for AI→blockchain auto-execution. Without these the backend still
# works (chat + DB) but transactions stay as 'pending' (no on-chain action).

# UGF API key — obtain from https://universalgasframework.com or Tychi Labs
UGF_API_KEY=your_ugf_api_key_here

# Private key of the server wallet that pays gas in TYI Mock USD on Base Sepolia.
# Fund this address with TYI Mock USD on the UGF testnet dashboard.
# ⚠️  Never commit a real private key — use a dedicated testnet wallet only.
UGF_SIGNER_PRIVATE_KEY=0xyour_hex_private_key_here

# Deployed ERC-721 contract address on Base Sepolia exposing:
#   mintBadge(address to, string tokenURI)
#   donate(address to, uint256 amount)
NFT_CONTRACT_ADDRESS=0xyour_contract_address_here

# Base Sepolia RPC (default is the public endpoint — override for reliability)
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
